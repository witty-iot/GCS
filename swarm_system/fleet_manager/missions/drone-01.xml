<?xml version="1.0" encoding="UTF-8"?>
<!-- Pushed to whichever Jetson the registry assigns drone_id="drone-01". v2.1 schema:
     action params live in plugins/<code>.meta.json, not here; actions are
     wrapped in <Actions mode="sequential|parallel">. -->
<Mission id="SWARM-DEMO-001" name="Swarm Field Spray - Drone 01" version="2.1">

  <Schedule>
    <StartDate>2026-10-14T06:00:00</StartDate>
    <TimeZone>Asia/Kolkata</TimeZone>
  </Schedule>

  <Fleet>
    <Drone id="drone-01" name="Alpha">
      <TakeoffAltitude>10</TakeoffAltitude>
      <DefaultSpeed>5</DefaultSpeed>

      <Waypoints>
        <Waypoint id="1">
          <Lat>28.6142</Lat><Lon>77.2093</Lon><Alt>10</Alt>
          <Actions>
            <Action code="spray_on"/>
          </Actions>
          <LoiterSec>1</LoiterSec>
          <Description>Alpha - spray on, entry edge of field A</Description>
        </Waypoint>

        <Waypoint id="2">
          <Lat>28.6146</Lat><Lon>77.2097</Lon><Alt>10</Alt>
          <Actions>
            <Action code="spray_pattern"/>
          </Actions>
          <Description>Alpha - spray pattern (params from plugins/spray_pattern.meta.json)</Description>
        </Waypoint>

        <Waypoint id="3">
          <Lat>28.6150</Lat><Lon>77.2101</Lon><Alt>10</Alt>
          <Actions>
            <Action code="spray_off"/>
          </Actions>
          <Description>Alpha - spray off, exit edge of field A</Description>
        </Waypoint>
      </Waypoints>
    </Drone>
  </Fleet>

  <Safety>
    <MinBatteryPercent>20</MinBatteryPercent>
    <MaxHdop>2.0</MaxHdop>
    <HeartbeatTimeoutSec>5</HeartbeatTimeoutSec>
    <GeofenceRadiusM>500</GeofenceRadiusM>
  </Safety>

  <RtlAfterMission>true</RtlAfterMission>
</Mission>
