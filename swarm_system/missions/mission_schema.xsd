<?xml version="1.0" encoding="UTF-8"?>
<!--
  mission_schema.xsd
  ------------------
  XML Schema Definition for multi-drone swarm mission files.

  Version: 2.0
  v2 changes from v1:
    - Waypoints now nest inside their owning <Drone>, not a flat sibling
      list cross-referenced by a drone_id attribute.
    - <Action> is fully generic: a "code" attribute + optional <Arg>
      children, resolved to a plugin at runtime. There is no longer a
      fixed enum of built-in actions (no more spray_on/spray_off special
      cased in the schema) — spraying is just one plugin among any
      number of others (take_photo, drop_payload, whatever you write).
    - A waypoint may have more than one <Action> — they run in the order
      written (e.g. spray_on and take_photo at the same point).
    - <ConnectionString> and <SpraySettings> are removed from <Drone>
      entirely. Hardware wiring (serial port, GPIO pins) is never
      mission data — it's local-only config on each Jetson, never
      transmitted over the network.
    - Waypoints may carry an optional per-waypoint <Speed>, overriding
      the drone's DefaultSpeed for that leg.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- =====================================================================
       Root Element: Mission
       ===================================================================== -->
  <xs:element name="Mission">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Schedule"         type="ScheduleType"/>
        <xs:element name="Fleet"            type="FleetType"/>
        <xs:element name="Safety"           type="SafetyType"/>
        <xs:element name="RtlAfterMission"  type="xs:boolean"/>
      </xs:sequence>
      <xs:attribute name="id"      type="xs:string"  use="required"/>
      <xs:attribute name="name"    type="xs:string"  use="required"/>
      <xs:attribute name="version" type="xs:string"  use="required"/>
    </xs:complexType>
  </xs:element>

  <!-- =====================================================================
       Schedule: defines when the mission starts and if it repeats
       ===================================================================== -->
  <xs:complexType name="ScheduleType">
    <xs:sequence>
      <!-- ISO 8601 datetime string e.g. 2026-10-14T06:00:00 -->
      <xs:element name="StartDate"   type="xs:string"/>
      <!-- IANA timezone name e.g. Asia/Kolkata -->
      <xs:element name="TimeZone"    type="xs:string"/>
      <!-- Optional cron expression for repeat e.g. "0 6 * * *" -->
      <xs:element name="RepeatCron"  type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- =====================================================================
       Fleet: collection of drones participating in the mission
       ===================================================================== -->
  <xs:complexType name="FleetType">
    <xs:sequence>
      <xs:element name="Drone" type="DroneType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- =====================================================================
       Drone: mission-relevant configuration for a single drone, plus its
       own nested waypoints. Deliberately contains nothing hardware-
       specific — no connection string, no GPIO pins. That lives only in
       each Jetson's local drone_config.yaml.
       ===================================================================== -->
  <xs:complexType name="DroneType">
    <xs:sequence>
      <!-- Takeoff altitude in metres above ground level -->
      <xs:element name="TakeoffAltitude"   type="xs:decimal"/>
      <!-- Default cruise speed in m/s, used when a waypoint has no own Speed -->
      <xs:element name="DefaultSpeed"      type="xs:decimal"/>
      <!-- This drone's own ordered waypoints -->
      <xs:element name="Waypoints"         type="WaypointsType"/>
    </xs:sequence>
    <xs:attribute name="id"   type="xs:string" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- =====================================================================
       Waypoints: ordered list of waypoints belonging to one drone
       ===================================================================== -->
  <xs:complexType name="WaypointsType">
    <xs:sequence>
      <xs:element name="Waypoint" type="WaypointType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- =====================================================================
       Waypoint: a single geographic target with an optional action
       ===================================================================== -->
  <xs:complexType name="WaypointType">
    <xs:sequence>
      <xs:element name="Lat"         type="xs:decimal"/>
      <xs:element name="Lon"         type="xs:decimal"/>
      <!-- Altitude in metres (absolute or relative to home depending on firmware) -->
      <xs:element name="Alt"         type="xs:decimal"/>
      <!-- Optional: cruise speed for this leg, overrides the drone's DefaultSpeed -->
      <xs:element name="Speed"       type="xs:decimal"  minOccurs="0"/>
      <!-- Optional: action to perform upon reaching this waypoint -->
      <xs:element name="Action"      type="ActionType"  minOccurs="0" maxOccurs="unbounded"/>
      <!-- Optional: seconds to loiter/hover at this waypoint -->
      <xs:element name="LoiterSec"   type="xs:decimal"  minOccurs="0" default="0"/>
      <!-- Human-readable description for logging / GCS display -->
      <xs:element name="Description" type="xs:string"   minOccurs="0" default=""/>
    </xs:sequence>
    <!-- Unique integer identifier for this waypoint, within its parent drone -->
    <xs:attribute name="id" type="xs:integer" use="required"/>
  </xs:complexType>

  <!-- =====================================================================
       Action: a generic action code resolved to a plugin at runtime
       (plugins/<code>.py, function run()) plus optional arguments.
       No fixed enum — any code is valid, as long as a matching plugin
       file exists.
       ===================================================================== -->
  <xs:complexType name="ActionType">
    <xs:sequence>
      <!-- Zero or more key-value argument pairs passed to the plugin's run() -->
      <xs:element name="Arg" type="ArgType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <!-- Action identifier, e.g. "spray_on", "take_photo", "spray_pattern" -->
    <xs:attribute name="code" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ArgType">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="key" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- =====================================================================
       Safety: operational limits and failsafe thresholds
       ===================================================================== -->
  <xs:complexType name="SafetyType">
    <xs:sequence>
      <!-- RTL is triggered when battery falls below this percentage -->
      <xs:element name="MinBatteryPercent"    type="xs:integer"/>
      <!-- Maximum acceptable HDOP value; above this GPS is considered poor -->
      <xs:element name="MaxHdop"              type="xs:decimal"/>
      <!-- Seconds without MAVSDK heartbeat before declaring drone lost -->
      <xs:element name="HeartbeatTimeoutSec"  type="xs:integer"/>
      <!-- Maximum distance from home position before geofence triggers RTL -->
      <xs:element name="GeofenceRadiusM"      type="xs:decimal"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
