<?xml version="1.0" encoding="UTF-8"?>
<!--
  standalone_mission.xml (v2 schema)

  Used automatically when a drone_node can't reach fleet_manager (no
  broker, no network, or just testing one drone by itself). Drone id
  "jetson-01" matches the default hardware_id in config/drone_config.yaml:
  in standalone mode the drone uses its own hardware_id as its drone_id.

  Waypoints now nest inside the Drone they belong to, and every action is
  a generic code resolved to plugins/<code>.py at runtime - no built-in
  action types. Hardware wiring (GPIO pin, pump timing) is NOT here; it
  lives in this Jetson's local drone_config.yaml under "hardware.spray".

  v2.1: action parameters (e.g. spray_pattern's "pattern"/"passes") are no
  longer authored here - see plugins/spray_pattern.meta.json. A waypoint's
  actions are wrapped in <Actions mode="sequential|parallel">.
-->
<Mission id="STANDALONE-001" name="Single Drone Standalone Spray" version="2.1">

  <Schedule>
    <StartDate>2026-10-14T06:00:00</StartDate>
    <TimeZone>Asia/Kolkata</TimeZone>
  </Schedule>

  <Fleet>
    <Drone id="jetson-01" name="Solo">
      <TakeoffAltitude>10</TakeoffAltitude>
      <DefaultSpeed>5</DefaultSpeed>

      <Waypoints>
        <Waypoint id="1">
          <Lat>28.6142</Lat><Lon>77.2093</Lon><Alt>10</Alt>
          <Actions>
            <Action code="spray_on"/>
          </Actions>
          <LoiterSec>1</LoiterSec>
          <Description>Spray on at field entry</Description>
        </Waypoint>

        <Waypoint id="2">
          <Lat>28.6146</Lat><Lon>77.2097</Lon><Alt>10</Alt>
          <Speed>3</Speed>
          <Actions>
            <Action code="spray_pattern"/>
          </Actions>
          <Description>Spray pattern via plugin (params from plugins/spray_pattern.meta.json), slower pass</Description>
        </Waypoint>

        <Waypoint id="3">
          <Lat>28.6150</Lat><Lon>77.2101</Lon><Alt>10</Alt>
          <Actions>
            <Action code="spray_off"/>
          </Actions>
          <Description>Spray off at field exit</Description>
        </Waypoint>

        <Waypoint id="4">
          <Lat>28.6152</Lat><Lon>77.2103</Lon><Alt>10</Alt>
          <Actions>
            <Action code="window_clean"/>
          </Actions>
          <LoiterSec>20</LoiterSec>
          <Description>Window inspection via vision model (params from plugins/window_clean.meta.json)</Description>
        </Waypoint>
      </Waypoints>
    </Drone>
  </Fleet>

  <Safety>
    <MinBatteryPercent>20</MinBatteryPercent>
    <MaxHdop>2.0</MaxHdop>
    <HeartbeatTimeoutSec>5</HeartbeatTimeoutSec>
    <GeofenceRadiusM>500</GeofenceRadiusM>
  </Safety>

  <RtlAfterMission>true</RtlAfterMission>
</Mission>
